{
  "name": "bitcoin-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Bitcoin Academy - 比特币交互式学习系统",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "verify:courses": "esbuild scripts/validate-courses.mjs --bundle --format=esm --platform=node --outfile=.tmp-validate.mjs --log-level=error && node .tmp-validate.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.462.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "@types/node": "^22.10.2"
  }
}
